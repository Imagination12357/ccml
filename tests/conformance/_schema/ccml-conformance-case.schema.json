{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccml.dev/schemas/ccml-conformance-case.schema.json",
  "title": "CCML Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "category",
    "description",
    "input",
    "expect"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": ["valid", "invalid", "warn"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string"
    },
    "expect": {
      "oneOf": [
        { "$ref": "#/$defs/expect_ok" },
        { "$ref": "#/$defs/expect_ok_with_warnings" },
        { "$ref": "#/$defs/expect_error" }
      ]
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message_contains"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "const": "warning" },
        "message_contains": { "type": "string", "minLength": 1 }
      }
    },
    "expect_ok": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "output_json"],
      "properties": {
        "status": { "type": "string", "const": "ok" },
        "output_json": { "type": "string" }
      }
    },
    "expect_ok_with_warnings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "output_json", "warnings"],
      "properties": {
        "status": { "type": "string", "const": "ok_with_warnings" },
        "output_json": { "type": "string" },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "expect_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "line", "column"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 },
            "message_contains": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
